    "@workspace/integrations-gemini-ai": "workspace:*",
    "@replit/connectors-sdk": "^0.4.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "@clerk/express": "2.1.67",
    "@clerk/shared": "4.31.1",
    "http-proxy-middleware": "3.0.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
